---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const slug = post.id.replace(/\.md$/, '');

// GL-256: relatedTerms -> nazwy haseł ze słownika
const glossary = await getCollection('slownik', ({ data }) => !data.draft);
const relatedTerms = (d.relatedTerms ?? [])
  .map((s) => glossary.find((t) => t.id.replace(/\.md$/, '') === s))
  .filter(Boolean)
  .map((t) => ({ slug: t!.id.replace(/\.md$/, ''), term: t!.data.term }));

const breadcrumbs = [
  { name: 'Strona główna', href: '/' },
  { name: 'Blog', href: '/blog/' },
  { name: d.title, href: `/blog/${slug}/` },
];
---

<ArticleLayout
  title={d.title}
  seoTitle={d.seoTitle}
  description={d.description}
  pubDate={d.pubDate}
  updatedDate={d.updatedDate}
  author={d.author}
  keywords={d.keywords}
  image={d.image}
  imageAlt={d.imageAlt}
  breadcrumbs={breadcrumbs}
  headings={headings}
  relatedTerms={relatedTerms}
>
  <Content />
</ArticleLayout>
