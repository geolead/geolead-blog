const T = window.__GL_T; // słownik bieżącego języka (src/i18n/home-dict.mjs)

/* ============================================================
   FORMS API CONFIG
   ────────────────────────────────────────────────────────────
   Web3Forms — darmowe do 250 maili/mies., zero backendu:
     1. Wejdź na https://web3forms.com → wpisz e-mail → kliknij "Create Access Key"
     2. Skopiuj klucz i wklej go w FORMS_API_KEY poniżej
   Alternatywa — Formspree: podmień FORMS_ENDPOINT na swój URL
   ============================================================ */
  const FORMS_API_KEY  = 'd3be610b-de09-436b-99c7-cf466f349c31';
  const FORMS_ENDPOINT = 'https://api.web3forms.com/submit';

/* ============================================================
   FORMS — centralny fetch + walidacja klucza
   ============================================================ */
function _checkApiKey(){
  if(FORMS_API_KEY.includes('TUTAJ_WKLEJ')){
    alert('BŁĄD KONFIGURACJI: Nie podałeś własnego klucza Web3Forms!');
    return false;
  }
  return true;
}
function _w3fFetch(payload,onSuccess,onError){
  fetch(FORMS_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(payload)})
  .then(async r=>{
    let data; try{data=await r.json();}catch(e){data={};}
    if(!r.ok||data.success===false){throw new Error(data.message||('HTTP '+r.status));}
    return data;
  })
  .then(d=>{try{gtag('event','generate_lead',{form_type:payload.source||'form',language:(typeof lang!=='undefined'?lang:'pl')});}catch(e){}return d;})
  .then(onSuccess)
  .catch(err=>{console.warn('[GeoLead Web3Forms error]',err.message);onError(err);});
}

/* ============================================================
   CALC MATRIX (PLN base prices)
   ============================================================ */
const MATRIX = {
  'high,local':    {pot:'high',     mLo:3,mHi:4, pLo:3000, pHi:6000},
