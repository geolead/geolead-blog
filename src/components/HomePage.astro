          <div style="display:flex;gap:5px">
            <div style="width:10px;height:10px;border-radius:50%;background:#ff5f57"></div>
            <div style="width:10px;height:10px;border-radius:50%;background:#febc2e"></div>
            <div style="width:10px;height:10px;border-radius:50%;background:#28c840"></div>
          </div>
          <div style="flex:1;text-align:center;font-size:0.68rem;font-weight:600;color:#6a7a95;letter-spacing:0.1em;font-family:inherit">GeoLead.AI — Entity Analysis Engine v1.4</div>
          <div style="display:flex;align-items:center;gap:0.35rem;font-size:0.6rem;color:#657a9f;font-family:inherit">
            <div id="scanStatusDot" style="width:6px;height:6px;border-radius:50%;background:#28c840;box-shadow:0 0 6px #28c840"></div>
            <span id="scanStatusTxt" data-i18n="scan_ready" set:html={t["scan_ready"]}></span>
          </div>
        </div>
        <!-- Body -->
        <div style="padding:1.35rem 1.35rem 0">
          <div id="scanInputRow" style="display:flex;align-items:center;gap:0.6rem;margin-bottom:1.1rem;flex-wrap:wrap">
            <span style="color:#00d4ff;font-size:0.8rem;flex-shrink:0;user-select:none">$&gt;</span>
            <input id="scanUrl" type="url" data-i18n-ph="scan_ph" placeholder={t["scan_ph"]}
              style="flex:1;min-width:180px;background:rgba(255,255,255,0.04);border:1px solid rgba(0,212,255,0.22);border-radius:8px;padding:0.58rem 0.85rem;font-size:0.83rem;color:#a0aec0;font-family:inherit;outline:none;transition:border-color .25s"
              onfocus="this.style.borderColor='rgba(0,212,255,0.6)'" onblur="this.style.borderColor='rgba(0,212,255,0.22)'">
            <button id="scanBtn" onclick="startScan()"
              style="background:linear-gradient(135deg,var(--f),var(--c));color:var(--bg);font-weight:700;font-size:0.8rem;padding:0.58rem 1.2rem;border-radius:8px;border:none;cursor:pointer;font-family:inherit;white-space:nowrap;transition:opacity .2s,transform .2s;display:flex;align-items:center;gap:0.4rem"
