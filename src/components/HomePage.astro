   ============================================================ */
const RL_KEY='gl_calc_v2', MAX_USES=3, WIN=864e5;
function getRLD(){try{const r=localStorage.getItem(RL_KEY);if(!r)return{c:0,t:Date.now()};const d=JSON.parse(r);return Date.now()-d.t>WIN?{c:0,t:Date.now()}:d;}catch{return window._rld||(window._rld={c:0,t:Date.now()})}}
function saveRLD(d){try{localStorage.setItem(RL_KEY,JSON.stringify(d));}catch{window._rld=d}}
function getRem(){return Math.max(0,MAX_USES-getRLD().c)}
function updateDots(){
  const rem=getRem(),t=T[lang];
  ['ud1','ud2','ud3'].forEach((id,i)=>{const el=document.getElementById(id);el.className='udot';if(i<rem)el.classList.add(rem===1?'warn':'used');});
  const ut=document.getElementById('usageTxt');
  if(ut&&t['usage_left_'+rem])ut.textContent=t['usage_left_'+rem];
}

