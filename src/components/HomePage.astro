updateDots();
(function initLang(){
  // D5: stare adresy ?lang=xx -> /xx/ (wersje językowe mają własne URL-e)
  try{
    var q=new URLSearchParams(location.search).get('lang');
    q=q&&q.toLowerCase();
    if(q&&['pl','en','de','fr'].indexOf(q)>-1&&q!==lang){location.replace(q==='pl'?'/':'/'+q+'/');return;}
  }catch(e){}
  setLang(lang);
})();
</script>
