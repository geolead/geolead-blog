const SCAN_LOG_COLORS={'INFO':'#68d391','SCAN':'#63b3ed','WARN':'#f6e05e','FAIL':'#fc8181','DONE':'#e040fb'};
let scanRunning=false;

function startScan(){
  if(scanRunning)return;
  const urlInput=document.getElementById('scanUrl');
  const url=urlInput.value.trim();
  // GL-226: demo zastąpione prawdziwym skanerem — przekierowanie z domeną.
  if(url){try{gtag('event','scanner_redirect');}catch(e){}location.href='/narzedzia/skaner-ai/?url='+encodeURIComponent(url);return;}
  if(!url){urlInput.style.borderColor='rgba(255,80,80,0.6)';urlInput.style.animation='shake .35s ease';setTimeout(()=>{urlInput.style.animation='';urlInput.style.borderColor='rgba(0,212,255,0.22)';},400);return;}
  scanRunning=true;
  try{gtag('event','scanner_start');}catch(e){}
  const t=T[lang];const logLines=t.scan_log||[];
  let domain=url.replace(/^https?:\/\//,'').replace(/\/.*$/,'');
  document.getElementById('scanInputRow').style.display='none';
  ['scanResults','scanGateWrap'].forEach(id=>{const el=document.getElementById(id);if(el)el.style.display='none';});
  const logEl=document.getElementById('scanLog');logEl.style.display='block';logEl.innerHTML='';
  document.getElementById('scanProgressWrap').style.display='block';
  document.getElementById('scanProgressBar').style.width='0%';
  document.getElementById('scanPct').textContent='0%';
  document.getElementById('scanStatusDot').style.cssText='width:6px;height:6px;border-radius:50%;background:#e040fb;box-shadow:0 0 8px #e040fb';
  document.getElementById('scanStatusTxt').textContent='SCANNING...';
  const totalLines=logLines.length;
  logLines.forEach(([tag,msg],i)=>{
    const delay=280+i*360+Math.random()*100;
    setTimeout(()=>{
      const color=SCAN_LOG_COLORS[tag]||'#68d391';
      const line=document.createElement('div');
      line.style.cssText='font-size:0.77rem;line-height:1.7;display:flex;gap:0.45rem;align-items:baseline';
      const ts=new Date().toTimeString().slice(0,8);
      line.innerHTML=`<span style="color:#6a7a95;flex-shrink:0;font-size:0.65rem">${ts}</span><span style="color:${color};font-weight:700;font-size:0.68rem;flex-shrink:0">[${tag}]</span><span style="color:${(tag==='FAIL'||tag==='WARN')?color:'#718096'}">${msg.replace('domeny...',domain+'...')}</span>`;
      logEl.appendChild(line);logEl.scrollTop=logEl.scrollHeight;
      const pct=Math.round(((i+1)/totalLines)*100);
      document.getElementById('scanProgressBar').style.width=pct+'%';
      document.getElementById('scanPct').textContent=pct+'%';
      if(i===totalLines-1)setTimeout(showScanResults,650);
    },delay);
  });
}

function showScanResults(){
  document.getElementById('scanStatusDot').style.cssText='width:6px;height:6px;border-radius:50%;background:#fc8181;box-shadow:0 0 8px #fc8181';
  document.getElementById('scanStatusTxt').textContent='COMPLETE';
