const CALC_IND=window.__GL_IND; // src/i18n/home-industries.json
const IND_TIER=Object.fromEntries(CALC_IND.map(x=>[x.id,x.t]));
let calcTimer=null, pendingInd='', pendingReach='';

function runCalc(){
  const ind=document.getElementById('calcIndustry').value;
  const reach=document.getElementById('calcReach').value;
  if(!ind||!reach){
    const b=document.getElementById('calcBtn');
    b.style.animation='shake .35s ease';
    setTimeout(()=>b.style.animation='',400);
    return;
  }
  if(getRem()<=0){showLimit();return;}
  try{gtag('event','calculator_run',{industry:ind,reach:reach});}catch(e){}
  const d=getRLD();d.c++;d.t=d.t||Date.now();saveRLD(d);updateDots();
  pendingInd=ind; pendingReach=reach;
  ['calcResults','gateForm'].forEach(id=>document.getElementById(id).style.display='none');
  document.getElementById('calcLimit').style.display='none';
  document.getElementById('calcBtn').disabled=true;
  const loading=document.getElementById('calcLoading'), lb=document.getElementById('loadBar');
  loading.style.display='block'; lb.style.width='0%';
  let pct=0;
  if(calcTimer)clearInterval(calcTimer);
  calcTimer=setInterval(()=>{pct=Math.min(pct+(Math.random()*4+1.5),97);lb.style.width=pct+'%';},55);
  setTimeout(()=>{
    clearInterval(calcTimer);lb.style.width='100%';
    setTimeout(()=>{
      loading.style.display='none';
      document.getElementById('calcBtn').disabled=false;
      showGate();
    },250);
  },1600);
}

