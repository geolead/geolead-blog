   ============================================================ */
function replayConsole(){
  const t=T[lang];
  if(twTimer){clearInterval(twTimer);twTimer=null;}
  const bU=document.getElementById('bubbleUser'),mA=document.getElementById('msgAi'),
        aA=document.getElementById('aiAvatar'),bA=document.getElementById('bubbleAi'),
        rB=document.getElementById('replayBtn');
  bU.textContent=''; bU.classList.remove('show');
  mA.style.display='none'; aA.classList.remove('show');
  bA.innerHTML='<div class="tyd" id="typingDots"><span></span><span></span><span></span></div>';
  bA.classList.remove('show'); rB.classList.remove('show');

  setTimeout(()=>{
    bU.classList.add('show');
    let i=0;
    twTimer=setInterval(()=>{
      if(i<t.user_msg.length){bU.textContent+=t.user_msg[i++];}
      else{
        clearInterval(twTimer); twTimer=null;
        setTimeout(()=>{
          mA.style.display='flex';
          setTimeout(()=>{aA.classList.add('show');bA.classList.add('show');},60);
          setTimeout(()=>{
            const td=document.getElementById('typingDots'); if(td)td.remove();
            const tS=document.createElement('span'); bA.appendChild(tS);
            const cur=document.createElement('span'); cur.className='cursor-blink'; bA.appendChild(cur);
            const full=t.ai_msg_p1+t.ai_link+t.ai_msg_p2;
            const p1l=t.ai_msg_p1.length, lkl=t.ai_link.length; let ci=0;
            const at=setInterval(()=>{
              if(ci<full.length){
                const ch=full[ci++];
                if(ci<=p1l){tS.textContent+=ch;}
                else if(ci===p1l+1){const lk=document.createElement('a');lk.href='https://geolead.pl';lk.className='ai-lnk';lk.textContent=ch;bA.insertBefore(lk,cur);}
                else if(ci<=p1l+lkl){const lk=bA.querySelector('.ai-lnk');if(lk)lk.textContent+=ch;}
                else{let tr=bA.querySelector('.trail');if(!tr){tr=document.createElement('span');tr.className='trail';bA.insertBefore(tr,cur);}tr.textContent+=ch;}
              } else {
                clearInterval(at); cur.remove();
                setTimeout(()=>rB.classList.add('show'),400);
              }
            },22);
          },1400);
        },360);
      }
    },38);
  },800);
}

