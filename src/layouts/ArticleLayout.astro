---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Crumb } from '../components/Breadcrumbs.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  keywords?: string[];
  image?: string;
  imageAlt?: string;
  breadcrumbs: Crumb[];
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = 'GeoLead',
  keywords = [],
  image = '/og-image.jpg',
  imageAlt = 'GeoLead — Agencja GEO',
  breadcrumbs,
  headings = [],
} = Astro.props;

const site = 'https://geolead.pl';

// ── Autor (GL-207): osoba zamiast organizacji — E-E-A-T ──
const founder = {
  id: `${site}/#jaroslaw-zagajewski`,
  name: 'Jarosław Zagajewski',
  jobTitle: 'Founder & GEO Strategist',
  linkedin: 'https://www.linkedin.com/in/jaroslaw-pawel-zagajewski-3b6748363/',
  bio: 'Założyciel GeoLead. Ponad 15 lat w finansach i controllingu międzynarodowych firm produkcyjnych, wcześniej audyt i due diligence w Deloitte. Absolwent SGH. Do GEO wnosi dyscyplinę CFO: każdy wynik ma metodę pomiaru, punkt odniesienia i datę.',
};
const isFounder = !author || author === 'GeoLead';
const authorName = isFounder ? founder.name : author;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = image.startsWith('http') ? image : `${site}${image}`;

const published = pubDate.toISOString();
const modified = (updatedDate ?? pubDate).toISOString();

// Czytelna data PL
const dateLabel = new Intl.DateTimeFormat('pl-PL', {
  year: 'numeric', month: 'long', day: 'numeric',
}).format(pubDate);

// ── JSON-LD Article ──
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: title,
  description: description,
  image: ogImage,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'pl-PL',
  author: isFounder
    ? {
        '@type': 'Person',
        '@id': founder.id,
        name: founder.name,
        jobTitle: founder.jobTitle,
        url: `${site}/#social-proof`,
        sameAs: [founder.linkedin],
        worksFor: { '@id': `${site}/#organization` },
      }
    : { '@type': 'Person', name: author },
  publisher: {
    '@type': 'Organization',
    '@id': `${site}/#organization`,
    name: 'GeoLead',
    logo: { '@type': 'ImageObject', url: `${site}/logo.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  keywords: keywords.join(', '),
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  publishedTime={published}
  modifiedTime={modified}
  keywords={keywords}
  author={authorName}
  authorUrl={isFounder ? founder.linkedin : undefined}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(articleJsonLd)}
  />

  <article>
    <div class="article-shell">
      <header class="article-header">
        <Breadcrumbs items={breadcrumbs} />
        <span class="article-kicker">Generative Engine Optimization</span>
        <h1 class="article-title">{title}</h1>
        <div class="article-meta">
          <span>Autor: {isFounder
            ? <a href={founder.linkedin} rel="author noopener" target="_blank" class="author-link"><strong>{founder.name}</strong></a>
            : <strong style="color:var(--text-hi)">{authorName}</strong>}{isFounder && <span class="author-role">, {founder.jobTitle}</span>}</span>
          <span class="sep" style="opacity:.4">·</span>
          <time datetime={published}>{dateLabel}</time>
          {updatedDate && (
            <>
              <span class="sep" style="opacity:.4">·</span>
              <span>Aktualizacja: {new Intl.DateTimeFormat('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' }).format(updatedDate)}</span>
            </>
          )}
        </div>
      </header>

      <div class="article-grid">
        <aside class="article-toc">
          <TableOfContents headings={headings} />
        </aside>
        <div class="prose-body">
          <slot />
          {isFounder && (
            <aside class="author-box" aria-label="O autorze">
              <div class="author-av" aria-hidden="true">JZ</div>
              <div>
                <span class="author-k">O autorze</span>
                <p class="author-name">{founder.name}</p>
                <p class="author-job">{founder.jobTitle}, GeoLead</p>
                <p class="author-bio">{founder.bio}</p>
                <div class="author-links">
                  <a href={founder.linkedin} rel="author noopener" target="_blank">LinkedIn</a>
                  <a href="/#contact">Umów rozmowę</a>
                </div>
              </div>
            </aside>
          )}
        </div>
      </div>
    </div>
  </article>

  <style>
    .article-shell { max-width: 1080px; margin: 0 auto; padding: 0 1.5rem; }
    .article-header { padding: 4rem 0 2.5rem; max-width: 760px; }
    .article-grid {
      display: grid;
      grid-template-columns: 220px minmax(0, 760px);
      gap: 3rem;
      align-items: start;
    }
    .article-toc { order: -1; }
    .author-link { color: var(--text-hi); text-decoration: none; border-bottom: 1px solid var(--border-f); }
    .author-link:hover { color: var(--f); }
    .author-role { opacity: .75; }
    .author-box {
      display: flex; gap: 1.25rem; align-items: flex-start;
      margin: 3rem 0 1rem; padding: 1.5rem;
      background: rgba(255,255,255,0.035);
      border: 1px solid var(--border-f); border-radius: 18px;
      backdrop-filter: blur(12px);
    }
    .author-av {
      flex-shrink: 0; width: 64px; height: 64px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-weight: 900; font-size: 1.2rem; color: #070712;
      background: linear-gradient(135deg, var(--f), var(--c));
    }
    .author-k { font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--f); }
    .author-box p { margin: 0; }
    .author-name { color: var(--text-hi); font-weight: 800; font-size: 1.15rem; margin-top: .2rem !important; }
    .author-job { color: var(--c); font-size: .85rem; font-weight: 600; margin: .1rem 0 .6rem !important; }
    .author-bio { color: var(--text); font-size: .92rem; line-height: 1.7; }
    .author-links { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: .8rem; }
    .author-links a {
      font-size: .82rem; color: var(--text-hi); text-decoration: none;
      border: 1px solid var(--border); border-radius: 999px; padding: .35rem .85rem;
    }
    .author-links a:hover { border-color: var(--f); color: var(--f); }
    @media (max-width: 640px) { .author-box { flex-direction: column; } }
    /* Poniżej 980px: ToC chowamy (sticky sidebar nie ma sensu na wąskim ekranie) */
    @media (max-width: 980px) {
      .article-grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
      .article-toc { display: none; }
    }
  </style>
</BaseLayout>
