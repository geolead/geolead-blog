---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
  noindex?: boolean;
  author?: string;
  authorUrl?: string;
}

const {
  title,
  description,
  image = '/og-image.jpg',
  imageAlt = 'GeoLead — Agencja GEO',
  type = 'website',
  publishedTime,
  modifiedTime,
  keywords = [],
  noindex = false,
  author = 'GeoLead',
  authorUrl,
} = Astro.props;

const site = 'https://geolead.pl';
// Kanoniczny URL bieżącej strony (bez query/hash), z trailing slash
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = image.startsWith('http') ? image : `${site}${image}`;
---

<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />

  <!-- Google tag (gtag.js) + Consent Mode v2 (GL-208) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      wait_for_update: 500
    });
    try { if (localStorage.getItem('gl_cookie') === 'accepted') { gtag('consent', 'update', { analytics_storage: 'granted' }); } } catch (e) {}
    gtag('js', new Date());
    // GA tylko na domenie produkcyjnej; ?gl_internal=1 / ?gl_internal=0 oznacza przeglądarkę jako ruch wewnętrzny (GA4 traffic_type)
    if (/^(www\.)?geolead\.pl$/.test(location.hostname)) {
      var glInternal = false;
      try {
        var glFlag = location.search.match(/[?&]gl_internal=([01])(?:&|$)/);
        if (glFlag) localStorage.setItem('gl_internal', glFlag[1]);
        glInternal = localStorage.getItem('gl_internal') === '1';
      } catch (e) {}
      gtag('config', 'G-4J1CCWLDHP', glInternal ? { traffic_type: 'internal' } : {});
    }
  </script>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4J1CCWLDHP"></script>

  <!-- PRIMARY META -->
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="author" content={author} />

  <!-- ANTI-HALLUCINATION DISAMBIGUATION (spójne ze stroną główną) -->
  <meta name="abstract" content="GeoLead to nie jest firma geodezyjna. GeoLead to agencja marketingowo-technologiczna (AI Search) pozycjonująca firmy w Sztucznej Inteligencji." />

  <!-- CANONICAL -->
  {!noindex && <link rel="canonical" href={canonical} />}

  <!-- FAVICON -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/logo.png" />

  <!-- HREFLANG (scaffold pod i18n — aktywne tylko PL, gotowe na EN/DE/FR) -->
  {!noindex && <link rel="alternate" hreflang="pl" href={canonical} />}
  {!noindex && <link rel="alternate" hreflang="x-default" href={canonical} />}
  <!--
    Przy skalowaniu odkomentuj i wygeneruj per-locale:
    <link rel="alternate" hreflang="en" href={`${site}/en${Astro.url.pathname}`} />
    <link rel="alternate" hreflang="de" href={`${site}/de${Astro.url.pathname}`} />
    <link rel="alternate" hreflang="fr" href={`${site}/fr${Astro.url.pathname}`} />
  -->

  <!-- OPEN GRAPH -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:site_name" content="GeoLead" />
  <meta property="og:locale" content="pl_PL" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  {type === 'article' && <meta property="article:author" content={authorUrl ?? author} />}

  <!-- TWITTER CARD -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@GeoLead_PL" />
  {type === 'article' && author === 'Jarosław Zagajewski' && <meta name="twitter:creator" content="@MrZagajewski" />}
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Slot na JSON-LD specyficzny dla strony (Article, BreadcrumbList itd.) -->
  <slot name="head" />
</head>
<body>
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />
  <script is:inline>
    /* GL-208: kliknięcia w CTA kontaktu / telefon / e-mail z bloga i słownika */
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href*="#contact"],a[href^="tel:"],a[href^="mailto:"]');
      if (!a || typeof gtag !== 'function') return;
      var h = a.getAttribute('href') || '';
      gtag('event', h.indexOf('#contact') > -1 ? 'cta_contact_click' : 'contact_click', { method: h.indexOf('tel:') === 0 ? 'phone' : (h.indexOf('mailto:') === 0 ? 'email' : 'cta'), page_path: location.pathname });
    });
  </script>
</body>
</html>
